# Database
# DATABASE_URL is what the running app uses. On Neon/Supabase use their *pooled* string.
DATABASE_URL="postgresql://docbook:docbook@localhost:5432/docbook?schema=public"
# DIRECT_DATABASE_URL is used only by the Prisma CLI (migrate, introspect) — never by the
# app at runtime, so it does NOT belong in apphosting.yaml. Migrations take a session-level
# advisory lock that transaction pooling breaks, which is why they need the direct endpoint.
# For a plain single Postgres (local, Cloud SQL) set it to the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://docbook:docbook@localhost:5432/docbook?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# AI (Phase 10). "rule-based" is a real keyword-triage adapter that needs no key, no
# network, and sends nothing to a third party — a legitimate production choice where health
# data residency rules make an external model unacceptable. "claude" calls the Anthropic
# Messages API and REQUIRES ANTHROPIC_API_KEY (it errors rather than silently downgrading).
AI_PROVIDER="rule-based"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
# Salt for hashing AI rate-limit actor keys (IPs / user ids) so the usage ledger never
# stores who searched which symptoms. Optional — falls back to NEXTAUTH_SECRET.
AI_ACTOR_SALT=""

# Payments (Phase 7, gateway added Round 4D) — DevPaymentAdapter needs no keys.
# Set PAYMENT_PROVIDER="paytabs" for real card processing (Jordan/MENA-focused hosted
# payment page). Requires PAYTABS_PROFILE_ID and PAYTABS_SERVER_KEY from the PayTabs
# dashboard (Developers > Key management). PAYTABS_BASE_URL defaults to
# https://secure.paytabs.com — override only for a region-specific endpoint or to point at
# a local mock server in tests. NEXT_PUBLIC_SITE_URL must be a real, publicly reachable
# HTTPS URL for the callback/return redirects PayTabs is given to work.
PAYMENT_PROVIDER="dev"
PAYTABS_PROFILE_ID=""
PAYTABS_SERVER_KEY=""
PAYTABS_BASE_URL="https://secure.paytabs.com"

# Notifications (Phase 9). "dev" adapters log instead of delivering. A production deploy
# that leaves these as "dev" logs a loud error per channel rather than failing, so
# notifications degrade without taking down booking.
EMAIL_PROVIDER="dev"
SMS_PROVIDER="dev"
WHATSAPP_PROVIDER="dev"
PUSH_PROVIDER="dev"

# WhatsApp Business inbound webhook (Phase 9). Needed only if you expose the webhook.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Clinical field encryption (Phase 8) — REQUIRED in production, and validated at startup.
# Must decode to exactly 32 bytes. Generate with:  openssl rand -base64 32
# Leaving this empty in production makes the app refuse to start (by design: clinical data
# must never be written unencrypted). In development a fixed insecure fallback is used.
FIELD_ENCRYPTION_KEY=""

# Storage (Phase 8)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./.storage"
# S3-compatible, when STORAGE_PROVIDER=s3
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# App. Do not set NODE_ENV here — Next.js manages it (`next dev` = development,
# `next build`/`next start` = production). Setting it manually causes confusing mismatches.
DEFAULT_COUNTRY="JO"
DEFAULT_LOCALE="ar"
