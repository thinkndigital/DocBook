# Database
# DATABASE_URL is what the running app uses. On Neon/Supabase use their *pooled* string.
DATABASE_URL="postgresql://docbook:docbook@localhost:5432/docbook?schema=public"
# DIRECT_DATABASE_URL is used only by the Prisma CLI (migrate, introspect) — never by the
# app at runtime, so it does NOT belong in apphosting.yaml. Migrations take a session-level
# advisory lock that transaction pooling breaks, which is why they need the direct endpoint.
# For a plain single Postgres (local, Cloud SQL) set it to the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://docbook:docbook@localhost:5432/docbook?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# AI (Phase 10). "rule-based" is a real keyword-triage adapter that needs no key, no
# network, and sends nothing to a third party — a legitimate production choice where health
# data residency rules make an external model unacceptable. "claude" calls the Anthropic
# Messages API and REQUIRES ANTHROPIC_API_KEY (it errors rather than silently downgrading).
AI_PROVIDER="rule-based"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
# Salt for hashing AI rate-limit actor keys (IPs / user ids) so the usage ledger never
# stores who searched which symptoms. Optional — falls back to NEXTAUTH_SECRET.
AI_ACTOR_SALT=""

# Payments (Phase 7, gateway added Round 4D) — DevPaymentAdapter needs no keys.
# Set PAYMENT_PROVIDER="paytabs" for real card processing (Jordan/MENA-focused hosted
# payment page). Requires PAYTABS_PROFILE_ID and PAYTABS_SERVER_KEY from the PayTabs
# dashboard (Developers > Key management). PAYTABS_BASE_URL defaults to
# https://secure.paytabs.com — override only for a region-specific endpoint or to point at
# a local mock server in tests. NEXT_PUBLIC_SITE_URL must be a real, publicly reachable
# HTTPS URL for the callback/return redirects PayTabs is given to work.
PAYMENT_PROVIDER="dev"
PAYTABS_PROFILE_ID=""
PAYTABS_SERVER_KEY=""
PAYTABS_BASE_URL="https://secure.paytabs.com"

# Recurring subscription billing (Round 4E) — expiry/reminder/cancellation, not auto-charge;
# renewal is always the tenant admin re-subscribing through the existing payment flow. This
# deployment target has no built-in cron, so an external scheduler (Cloud Scheduler,
# cron-job.org, a scheduled GitHub Action, etc.) must POST to
# /api/v1/cron/subscriptions/tick daily with `Authorization: Bearer $CRON_SECRET`. Generate
# with: openssl rand -base64 32
CRON_SECRET=""

# Notifications (Phase 9). "dev" adapters log instead of delivering. A production deploy
# that leaves these as "dev" logs a loud error per channel rather than failing, so
# notifications degrade without taking down booking.
#
# Set EMAIL_PROVIDER="sendgrid" for real delivery via SendGrid's v3 Mail Send API. Requires
# SENDGRID_API_KEY (SendGrid dashboard: Settings > API Keys) and EMAIL_FROM_ADDRESS, which
# must be a verified sender in that SendGrid account.
EMAIL_PROVIDER="dev"
SENDGRID_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="DocBook"

# Set SMS_PROVIDER and/or WHATSAPP_PROVIDER to "twilio" for real delivery via Twilio's
# Programmable Messaging API — one TwilioAdapter class serves both channels. Requires
# TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN (Twilio Console dashboard) shared between them,
# plus each channel's own sender number: TWILIO_SMS_FROM_NUMBER is any Twilio SMS-capable
# number; TWILIO_WHATSAPP_FROM_NUMBER must be a WhatsApp-enabled sender (Twilio's WhatsApp
# sandbox number while testing, a real approved sender for production).
SMS_PROVIDER="dev"
WHATSAPP_PROVIDER="dev"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM_NUMBER=""
TWILIO_WHATSAPP_FROM_NUMBER=""

# PUSH has no real adapter yet — device-token registration needs a mobile/web client this
# codebase doesn't implement (see src/lib/services/notifications.ts's `destinationFor` doc
# comment). Leave this on "dev" until that client-side piece exists; there is nothing to
# configure here that would make it real.
PUSH_PROVIDER="dev"

# WhatsApp Business inbound webhook (Phase 9). Needed only if you expose the webhook.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Clinical field encryption (Phase 8) — REQUIRED in production, and validated at startup.
# Must decode to exactly 32 bytes. Generate with:  openssl rand -base64 32
# Leaving this empty in production makes the app refuse to start (by design: clinical data
# must never be written unencrypted). In development a fixed insecure fallback is used.
FIELD_ENCRYPTION_KEY=""

# Storage (Phase 8; S3 adapter added in the production-hardening pass). "local" writes to
# disk and is fine for development, but that disk is ephemeral on most container platforms
# (App Hosting included) — vanishes on every rollout, not shared between instances. Set
# STORAGE_PROVIDER="s3" before any real patient document is uploaded.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./.storage"
# S3-compatible, when STORAGE_PROVIDER=s3. Signed with AWS Signature Version 4 (no SDK
# dependency) — real AWS S3 needs only the four below; a non-AWS S3-compatible provider
# (Cloudflare R2, DigitalOcean Spaces, self-hosted MinIO) additionally needs S3_ENDPOINT,
# which switches the adapter from AWS's virtual-hosted-style URLs to path-style.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# App. Do not set NODE_ENV here — Next.js manages it (`next dev` = development,
# `next build`/`next start` = production). Setting it manually causes confusing mismatches.
DEFAULT_COUNTRY="JO"
DEFAULT_LOCALE="ar"
