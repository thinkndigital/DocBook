# Database
DATABASE_URL="postgresql://docbook:docbook@localhost:5432/docbook?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# AI (Phase 10)
ANTHROPIC_API_KEY=""

# Payments (Phase 7) — DevPaymentAdapter needs no keys; fill when a real gateway is chosen
PAYMENT_PROVIDER="dev"

# Notifications (Phase 9). "dev" adapters log instead of delivering. A production deploy
# that leaves these as "dev" logs a loud error per channel rather than failing, so
# notifications degrade without taking down booking.
EMAIL_PROVIDER="dev"
SMS_PROVIDER="dev"
WHATSAPP_PROVIDER="dev"
PUSH_PROVIDER="dev"

# WhatsApp Business inbound webhook (Phase 9). Needed only if you expose the webhook.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Clinical field encryption (Phase 8) — REQUIRED in production, and validated at startup.
# Must decode to exactly 32 bytes. Generate with:  openssl rand -base64 32
# Leaving this empty in production makes the app refuse to start (by design: clinical data
# must never be written unencrypted). In development a fixed insecure fallback is used.
FIELD_ENCRYPTION_KEY=""

# Storage (Phase 8)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./.storage"
# S3-compatible, when STORAGE_PROVIDER=s3
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# App. Do not set NODE_ENV here — Next.js manages it (`next dev` = development,
# `next build`/`next start` = production). Setting it manually causes confusing mismatches.
DEFAULT_COUNTRY="JO"
DEFAULT_LOCALE="ar"
