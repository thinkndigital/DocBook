# Database
DATABASE_URL="postgresql://docbook:docbook@localhost:5432/docbook?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# AI (Phase 10)
ANTHROPIC_API_KEY=""

# Payments (Phase 7) — DevPaymentAdapter needs no keys; fill when a real gateway is chosen
PAYMENT_PROVIDER="dev"

# Notifications (Phase 9)
EMAIL_PROVIDER="dev"
SMS_PROVIDER="dev"
WHATSAPP_PROVIDER="dev"

# Clinical field encryption (Phase 8) — REQUIRED in production.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=""

# Storage (Phase 8)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./.storage"
# S3-compatible, when STORAGE_PROVIDER=s3
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# App
NODE_ENV="development"
DEFAULT_COUNTRY="JO"
DEFAULT_LOCALE="ar"
