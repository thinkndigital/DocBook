generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  /// Serverless Postgres providers (Neon, Supabase) hand out two connection strings: a
  /// *pooled* one through PgBouncer in transaction mode, and a *direct* one.
  ///
  /// The app wants the pooled endpoint — App Hosting scales to several instances, each with
  /// its own Prisma connection pool, and a small Postgres would otherwise run out of
  /// connections. But `prisma migrate` cannot use it: migrations take a session-level
  /// advisory lock to stop two deploys racing, and transaction pooling does not preserve
  /// session state, so the lock silently belongs to a different backend each statement. The
  /// symptom is a migration that hangs or fails with a confusing lock error.
  ///
  /// `directUrl` is Prisma's answer: migrations and introspection use it, the running app
  /// uses `url`. Set both to the same value for a plain single Postgres (local, Cloud SQL);
  /// set them differently on Neon/Supabase.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------- Enums ----------

enum TenantType {
  INDEPENDENT_DOCTOR
  CLINIC
  MEDICAL_CENTER
  HOSPITAL
  PHARMACY
  LABORATORY
  HEALTHCARE_GROUP
  CORPORATE
  INSURANCE_COMPANY
}

enum TenantStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  DOCTOR
  RECEPTIONIST
  REPRESENTATIVE
  PATIENT
  SUPPLIER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentType {
  IN_PERSON
  VIDEO
  FOLLOW_UP
  EMERGENCY
  HOME_VISIT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_QUEUE
  CALLED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum ScheduleExceptionType {
  HOLIDAY
  LEAVE
  EMERGENCY_CLOSURE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  /// A redirect-based gateway (e.g. a hosted payment page) accepted the request and is
  /// waiting for the payer to complete it out-of-band. Distinct from PENDING so the
  /// duplicate-payment guard blocks a second collection attempt while one is in flight,
  /// and so the UI can render a "resume or cancel" state instead of a generic pending spinner.
  AWAITING_REDIRECT
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  BANK_TRANSFER
  CASH
  INSURANCE
  CORPORATE_BILLING
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum CommissionEntityType {
  DOCTOR
  CLINIC
  REPRESENTATIVE
  PLATFORM
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum AiInteractionKind {
  SYMPTOM_TRIAGE
  PATIENT_ASSISTANT
  CLINIC_BRIEFING
}

enum VideoSessionStatus {
  SCHEDULED
  WAITING_ROOM
  IN_PROGRESS
  ENDED
  FAILED
}

enum AttachmentOwnerType {
  MEDICAL_RECORD
  PRESCRIPTION
  PATIENT_UPLOAD
  CLINIC_DOCUMENT
}

// ---------- Geography / country config ----------

model Country {
  id          String   @id @default(uuid())
  code        String   @unique // ISO 3166-1 alpha-2, e.g. "JO"
  name        String
  nameAr      String
  currency    String // ISO 4217, e.g. "JOD"
  phonePrefix String // e.g. "+962"
  timezone    String // e.g. "Asia/Amman"
  languages   String[] // e.g. ["ar", "en"]
  taxRules    Json? // VAT rate, invoicing requirements, etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cities              City[]
  tenants             Tenant[]
  partnerApplications PartnerApplication[]
  suppliers           Supplier[]

  @@map("countries")
}

model City {
  id        String   @id @default(uuid())
  countryId String
  name      String
  nameAr    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  country             Country              @relation(fields: [countryId], references: [id])
  branches            Branch[]
  partnerApplications PartnerApplication[]

  @@unique([countryId, name])
  @@map("cities")
}

// ---------- Tenancy ----------

model Tenant {
  id         String       @id @default(uuid())
  type       TenantType
  name       String
  nameAr     String
  countryId  String
  status     TenantStatus @default(PENDING_VERIFICATION)
  inviteCode String?      @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  country                   Country                    @relation(fields: [countryId], references: [id])
  users                     User[]
  branches                  Branch[]
  doctors                   Doctor[]
  services                  Service[]
  appointments              Appointment[]
  staff                     Staff[]
  subscriptions             Subscription[]
  insurances                TenantInsurance[]
  auditLogs                 AuditLog[]
  commissionRules           CommissionRule[]
  representativeAssignments RepresentativeAssignment[]
  aiInteractions            AiInteraction[]

  @@index([countryId])
  @@map("tenants")
}

model Branch {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  address       String
  cityId        String
  latitude      Float?
  longitude     Float?
  phone         String?
  openingHours  Json // { mon: [{start, end}], ... }
  parkingInfo   String?
  accessibility String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  city               City                @relation(fields: [cityId], references: [id])
  doctorBranches     DoctorBranch[]
  staff              Staff[]
  schedules          Schedule[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]

  @@index([tenantId])
  @@index([cityId])
  @@map("branches")
}

// ---------- Users & roles ----------

model User {
  id                   String     @id @default(uuid())
  tenantId             String? // null for PATIENT and SUPER_ADMIN
  email                String     @unique
  phone                String?
  passwordHash         String
  role                 UserRole
  status               UserStatus @default(ACTIVE)
  name                 String
  nameAr               String?
  locale               String     @default("ar")
  twoFactorEnabled     Boolean    @default(false)
  /// Base32 TOTP secret. Encrypted at rest with the same field encryption as clinical data —
  /// a leaked database must not hand over the second factor along with the first.
  twoFactorSecret      String?
  /// Bcrypt hashes of single-use recovery codes. Hashed, never stored in the clear: they
  /// are password-equivalent, and their whole purpose is to work when the authenticator is
  /// gone — which is exactly when a stolen list would be most useful to an attacker.
  twoFactorBackupCodes String[]   @default([])
  twoFactorEnrolledAt  DateTime?
  /// Set when an account is created *for* someone by an admin, since those start with the
  /// shared assigned password (DEFAULT_ASSIGNED_PASSWORD, which is committed to this repo).
  /// Until it is cleared the session can reach nothing but the change-password screen — a
  /// doctor account still on the published default is a way into their patients' records.
  /// Self-registered patients choose their own password and are never flagged.
  mustChangePassword   Boolean    @default(false)
  // Per-channel opt-out, e.g. { "SMS": false, "WHATSAPP": false }. Absent/true = enabled.
  // Kept as JSON rather than a table: it's a small per-user preference blob that is only
  // ever read whole, never queried across users.
  notificationPrefs    Json?
  lastLoginAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  tenant         Tenant?         @relation(fields: [tenantId], references: [id])
  patient        Patient?
  doctor         Doctor?
  staff          Staff?
  representative Representative?
  supplier       Supplier?
  auditLogs      AuditLog[]      @relation("AuditActor")
  notifications  Notification[]
  sentMessages   Message[]       @relation("MessageSender")
  aiInteractions AiInteraction[]

  @@index([tenantId])
  @@map("users")
}

model Patient {
  id               String    @id @default(uuid())
  userId           String    @unique
  dateOfBirth      DateTime?
  gender           Gender?
  nationalId       String?
  bloodType        String?
  allergies        String[]
  emergencyContact Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  familyMembers  FamilyMember[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  payments       Payment[]
  reviews        Review[]

  @@map("patients")
}

model FamilyMember {
  id          String    @id @default(uuid())
  patientId   String // the primary account holder
  name        String
  relation    String
  dateOfBirth DateTime?
  gender      Gender?
  createdAt   DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("family_members")
}

model Staff {
  id        String   @id @default(uuid())
  userId    String   @unique
  tenantId  String
  branchId  String?
  title     String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@map("staff")
}

model Representative {
  id                  String   @id @default(uuid())
  userId              String   @unique
  monthlyTargetAmount Int? // minor currency units
  createdAt           DateTime @default(now())

  user               User                       @relation(fields: [userId], references: [id])
  assignments        RepresentativeAssignment[]
  commissions        Commission[]
  bookedAppointments Appointment[]              @relation("BookedByRepresentative")

  @@map("representatives")
}

model RepresentativeAssignment {
  id               String   @id @default(uuid())
  representativeId String
  tenantId         String
  assignedAt       DateTime @default(now())

  representative Representative @relation(fields: [representativeId], references: [id])
  tenant         Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([representativeId, tenantId])
  @@map("representative_assignments")
}

// ---------- Clinical directory ----------

model Specialty {
  id       String  @id @default(uuid())
  slug     String  @unique
  name     String
  nameAr   String
  parentId String?

  parent   Specialty?  @relation("SpecialtyChildren", fields: [parentId], references: [id])
  children Specialty[] @relation("SpecialtyChildren")
  doctors  Doctor[]
  services Service[]

  @@map("specialties")
}

model Doctor {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  tenantId               String
  specialtyId            String
  subSpecialty           String?
  licenseNumber          String
  yearsExperience        Int       @default(0)
  bio                    String?
  bioAr                  String?
  gender                 Gender?
  languages              String[]
  verified               Boolean   @default(false)
  verificationStatus     String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  consultationPriceMinor Int
  currency               String    @default("JOD")
  ratingAverage          Float     @default(0)
  ratingCount            Int       @default(0)
  // Bearer token for the doctor's private iCal feed. Nullable until generated, unique so
  // the feed route can look up by it, and regenerating it instantly revokes old subscriptions.
  calendarFeedToken      String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  user               User                @relation(fields: [userId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  specialty          Specialty           @relation(fields: [specialtyId], references: [id])
  branches           DoctorBranch[]
  schedules          Schedule[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]
  medicalRecords     MedicalRecord[]
  prescriptions      Prescription[]
  reviews            Review[]
  equipmentOrders    EquipmentOrder[]

  @@index([tenantId])
  @@index([specialtyId])
  @@map("doctors")
}

model DoctorBranch {
  id       String @id @default(uuid())
  doctorId String
  branchId String

  doctor Doctor @relation(fields: [doctorId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([doctorId, branchId])
  @@map("doctor_branches")
}

model Service {
  id              String          @id @default(uuid())
  tenantId        String
  specialtyId     String?
  name            String
  nameAr          String
  priceMinor      Int
  currency        String          @default("JOD")
  durationMinutes Int
  type            AppointmentType @default(IN_PERSON)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  specialty    Specialty?    @relation(fields: [specialtyId], references: [id])
  appointments Appointment[]

  @@index([tenantId])
  @@map("services")
}

// ---------- Scheduling & appointments ----------

model Schedule {
  id                  String  @id @default(uuid())
  doctorId            String
  branchId            String
  dayOfWeek           Int // 0 = Sunday .. 6 = Saturday
  startTime           String // "09:00"
  endTime             String // "17:00"
  slotDurationMinutes Int     @default(20)
  bufferMinutes       Int     @default(0)
  isActive            Boolean @default(true)

  doctor Doctor @relation(fields: [doctorId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([doctorId, branchId])
  @@map("schedules")
}

model ScheduleException {
  id        String                @id @default(uuid())
  doctorId  String
  branchId  String
  date      DateTime
  type      ScheduleExceptionType
  startTime String?
  endTime   String?
  reason    String?

  doctor Doctor @relation(fields: [doctorId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([doctorId, date])
  @@map("schedule_exceptions")
}

model Appointment {
  id                       String            @id @default(uuid())
  tenantId                 String
  branchId                 String
  doctorId                 String
  patientId                String
  serviceId                String
  bookedByUserId           String? // receptionist/patient user id
  bookedByRepresentativeId String?
  type                     AppointmentType
  status                   AppointmentStatus @default(PENDING)
  scheduledAt              DateTime
  durationMinutes          Int
  queueToken               Int?
  checkedInAt              DateTime?
  calledAt                 DateTime?
  startedAt                DateTime?
  completedAt              DateTime?
  cancelReason             String?
  priceMinor               Int
  currency                 String            @default("JOD")
  insuranceProviderId      String?
  notes                    String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  deletedAt                DateTime?

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  branch            Branch             @relation(fields: [branchId], references: [id])
  doctor            Doctor             @relation(fields: [doctorId], references: [id])
  patient           Patient            @relation(fields: [patientId], references: [id])
  service           Service            @relation(fields: [serviceId], references: [id])
  representative    Representative?    @relation("BookedByRepresentative", fields: [bookedByRepresentativeId], references: [id])
  insuranceProvider InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])

  queueEvents    QueueEvent[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  payments       Payment[]
  commissions    Commission[]
  review         Review?
  videoSession   VideoSession?

  @@index([tenantId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([patientId])
  @@map("appointments")
}

model QueueEvent {
  id            String            @id @default(uuid())
  appointmentId String
  status        AppointmentStatus
  position      Int?
  createdAt     DateTime          @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@map("queue_events")
}

// ---------- Clinical records ----------

model MedicalRecord {
  id            String    @id @default(uuid())
  tenantId      String
  patientId     String
  doctorId      String?
  appointmentId String?
  type          String // VISIT_NOTE | LAB_REPORT | IMAGING | DIAGNOSIS
  diagnosis     String?
  notes         String?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  patient     Patient      @relation(fields: [patientId], references: [id])
  doctor      Doctor?      @relation(fields: [doctorId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  attachments Attachment[]

  @@index([patientId])
  @@index([tenantId])
  @@map("medical_records")
}

model Prescription {
  id              String    @id @default(uuid())
  tenantId        String
  medicalRecordId String?
  appointmentId   String
  doctorId        String
  patientId       String
  diagnosis       String?
  instructions    String?
  pdfStorageKey   String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  appointment Appointment  @relation(fields: [appointmentId], references: [id])
  doctor      Doctor       @relation(fields: [doctorId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  medications Medication[]
  attachments Attachment[]

  @@index([patientId])
  @@index([tenantId])
  @@map("prescriptions")
}

model Medication {
  id             String  @id @default(uuid())
  prescriptionId String
  name           String
  dosage         String
  frequency      String
  durationDays   Int?
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([prescriptionId])
  @@map("medications")
}

model Attachment {
  id               String              @id @default(uuid())
  ownerType        AttachmentOwnerType
  medicalRecordId  String?
  prescriptionId   String?
  tenantId         String
  patientId        String?
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  encrypted        Boolean             @default(false)
  uploadedByUserId String
  createdAt        DateTime            @default(now())

  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  prescription  Prescription?  @relation(fields: [prescriptionId], references: [id])

  @@index([medicalRecordId])
  @@index([prescriptionId])
  @@map("attachments")
}

// ---------- Insurance ----------

model InsuranceProvider {
  id        String   @id @default(uuid())
  name      String
  nameAr    String
  createdAt DateTime @default(now())

  tenants      TenantInsurance[]
  appointments Appointment[]

  @@map("insurance_providers")
}

model TenantInsurance {
  id                  String @id @default(uuid())
  tenantId            String
  insuranceProviderId String

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  insuranceProvider InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])

  @@unique([tenantId, insuranceProviderId])
  @@map("tenant_insurances")
}

// ---------- Billing: subscriptions, commissions, payments ----------

model SubscriptionPlan {
  id                   String           @id @default(uuid())
  tier                 SubscriptionTier
  name                 String
  priceMonthlyMinor    Int
  currency             String           @default("JOD")
  bookingCommissionPct Float            @default(0)
  maxBranches          Int?
  maxDoctors           Int?
  apiAccess            Boolean          @default(false)
  whiteLabel           Boolean          @default(false)
  features             Json
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([tenantId])
  @@map("subscriptions")
}

model CommissionRule {
  id              String               @id @default(uuid())
  tenantId        String?
  entityType      CommissionEntityType
  percentage      Float?
  flatAmountMinor Int?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())

  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  commissions Commission[]

  @@index([tenantId])
  @@map("commission_rules")
}

model Commission {
  id               String               @id @default(uuid())
  appointmentId    String
  // Nullable: the clinic's remainder share and the platform cut derived from the tenant's
  // subscription plan (SubscriptionPlan.bookingCommissionPct) are computed, not driven by
  // a CommissionRule row. See src/lib/services/commissions.ts.
  commissionRuleId String?
  representativeId String?
  tenantId         String
  entityType       CommissionEntityType
  amountMinor      Int
  currency         String               @default("JOD")
  status           CommissionStatus     @default(PENDING)
  createdAt        DateTime             @default(now())
  paidAt           DateTime?

  appointment    Appointment     @relation(fields: [appointmentId], references: [id])
  commissionRule CommissionRule? @relation(fields: [commissionRuleId], references: [id])
  representative Representative? @relation(fields: [representativeId], references: [id])

  @@index([representativeId])
  @@index([tenantId])
  @@map("commissions")
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String
  appointmentId  String?
  subscriptionId String?
  patientId      String?
  amountMinor    Int
  currency       String        @default("JOD")
  method         PaymentMethod
  provider       String // "dev" | "paytabs" | future gateway identifiers
  providerRef    String?
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  patient      Patient?      @relation(fields: [patientId], references: [id])
  transactions Transaction[]

  @@index([tenantId])
  @@index([appointmentId])
  @@map("payments")
}

model Transaction {
  id          String        @id @default(uuid())
  paymentId   String
  type        String // AUTHORIZE | CAPTURE | REFUND | PARTIAL_REFUND | VOID
  amountMinor Int
  status      PaymentStatus
  createdAt   DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("transactions")
}

// ---------- Reviews, messaging, notifications, video ----------

model Review {
  id             String       @id @default(uuid())
  appointmentId  String       @unique
  patientId      String
  doctorId       String
  tenantId       String
  ratingDoctor   Int
  ratingStaff    Int?
  ratingWaitTime Int?
  ratingClinic   Int?
  ratingOverall  Int
  comment        String?
  status         ReviewStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])
  doctor      Doctor      @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
  @@index([tenantId])
  @@map("reviews")
}

model Conversation {
  id        String   @id @default(uuid())
  tenantId  String?
  type      String // PATIENT_DOCTOR | PATIENT_CLINIC | REP_CLINIC
  createdAt DateTime @default(now())

  messages Message[]

  @@index([tenantId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  tenantId       String?
  body           String
  attachmentUrl  String?
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
  @@map("messages")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  tenantId  String?
  type      String // BOOKING_CREATED | BOOKING_CONFIRMED | ... (see brief §22)
  channel   NotificationChannel
  payload   Json
  status    NotificationStatus  @default(QUEUED)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

model VideoSession {
  id              String             @id @default(uuid())
  appointmentId   String             @unique
  roomId          String             @unique
  status          VideoSessionStatus @default(SCHEDULED)
  doctorJoinedAt  DateTime?
  patientJoinedAt DateTime?
  startedAt       DateTime?
  endedAt         DateTime?

  appointment Appointment   @relation(fields: [appointmentId], references: [id])
  signals     VideoSignal[]

  @@map("video_sessions")
}

/// Self-hosted WebRTC signaling — no video vendor is configured (see ARCHITECTURE.md), so
/// SDP offers/answers and ICE candidates are relayed through short-poll reads of this table
/// instead of a vendor's signaling channel. One row per message; `seq` (not `id`, which is a
/// random UUID) is what a poller cursors on, since it's the only column guaranteed ordered.
/// No tenantId here deliberately — same as VideoSession itself: a call's only two
/// legitimate readers are the doctor and patient on the appointment, checked explicitly in
/// src/lib/services/video.ts, not by tenant membership.
model VideoSignal {
  id             String   @id @default(uuid())
  seq            Int      @default(autoincrement())
  videoSessionId String
  fromRole       String // 'DOCTOR' | 'PATIENT'
  kind           String // 'offer' | 'answer' | 'ice-candidate'
  payload        Json
  createdAt      DateTime @default(now())

  videoSession VideoSession @relation(fields: [videoSessionId], references: [id])

  @@index([videoSessionId, seq])
  @@map("video_signals")
}

// ---------- AI (Phase 10) ----------

/// Ledger of AI usage. Three jobs, one table:
///   1. Rate limiting — the limiter counts rows in a window, so the limit holds across
///      every app instance instead of per-process like an in-memory bucket would.
///   2. Cost/latency observability per tenant and kind.
///   3. Governance — which disclaimer version a user was shown, and whether a red flag
///      fired, is answerable months later.
///
/// Deliberately stores NO prompt or response content. A symptom description is among the
/// most sensitive free text in the product; keeping a permanent, unencrypted copy of it in
/// a rate-limiting table would create exactly the exposure the clinical-field encryption in
/// Phase 8 exists to prevent. What is kept is metadata: how many characters, which
/// specialties were suggested (slugs — already public catalogue data), and how it went.
model AiInteraction {
  id                String            @id @default(uuid())
  kind              AiInteractionKind
  /// Null for anonymous public triage; set for authenticated calls.
  userId            String?
  /// Null for patient/public calls — matches the AuditLog/Notification optional-tenant pattern.
  tenantId          String?
  /// Rate-limit subject: user id when authenticated, hashed client IP when not. Hashed so
  /// the ledger never becomes a log of who searched which symptoms from which address.
  actorKey          String
  /// Adapter that served it: "rule-based" | "claude" | ... Lets a cost or quality question
  /// be scoped to the adapter that was actually live at the time.
  provider          String
  /// Length of the user's input. Enough for cost/abuse analysis, keeps none of the text.
  inputChars        Int               @default(0)
  /// Specialty slugs returned, for triage. Public catalogue data, not clinical content.
  suggestedSlugs    String[]
  /// True when the deterministic red-flag check fired — the number that matters when
  /// asking "is the emergency path actually reaching people".
  redFlagged        Boolean           @default(false)
  /// True when a likely prompt-injection attempt was detected (logged, not blocked).
  injectionFlagged  Boolean           @default(false)
  /// Disclaimer wording the user was shown with this response.
  disclaimerVersion String
  latencyMs         Int               @default(0)
  /// False when the provider failed and a deterministic fallback served the response.
  succeeded         Boolean           @default(true)
  createdAt         DateTime          @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([actorKey, createdAt])
  @@index([tenantId, createdAt])
  @@map("ai_interactions")
}

// ---------- Security (Phase 12) ----------

/// Generic rate-limit / lockout ledger.
///
/// One row per attempt, counted over a window. Deliberately database-backed rather than an
/// in-process counter: this app runs behind a load balancer with N replicas, so an
/// in-memory limit of 10/hour is really 10N/hour and resets on every deploy. For login
/// throttling that is the difference between a control and a decoration.
///
/// `key` is always a **salted hash** of the subject (IP, email, or user id) — the limiter
/// only ever needs equality, never the value, and storing raw addresses against login
/// timestamps would build a movement log with no operational upside.
model RateLimitHit {
  id        String   @id @default(uuid())
  /// Which limit this belongs to, e.g. "login", "register", "ai:triage".
  bucket    String
  /// Salted hash of the subject.
  key       String
  /// False for a failed attempt — lets the login limiter count only failures.
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([bucket, key, createdAt])
  @@map("rate_limit_hits")
}

// ---------- Audit ----------

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  beforeState Json?
  afterState  Json?
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// A clinic or hospital asking to join the platform.
///
/// Deliberately **not** a Tenant. Nothing here grants access: it is an inbound enquiry from
/// an unauthenticated visitor, reviewed by a human, and approval means a platform admin
/// then creates the tenant through the ordinary `/admin/tenants` flow. Letting a public form
/// write a Tenant row — even a pending one — would put the tenant table, which every
/// isolation guarantee is keyed on, behind a box anyone on the internet can type into.
///
/// It carries no `tenantId` and is not registered in `src/lib/tenant.ts`: it exists before
/// any tenant does, so there is no context to scope it by. Only `SUPER_ADMIN` can read it.
model PartnerApplication {
  id               String                   @id @default(uuid())
  organizationName String
  type             TenantType
  countryId        String
  cityId           String?
  contactName      String
  contactEmail     String
  contactPhone     String
  /// Self-reported, for triage only — never treated as a verified figure.
  doctorCount      Int?
  notes            String?
  status           PartnerApplicationStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  /// Internal note from the reviewer. Never shown to the applicant.
  reviewNotes      String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  country Country @relation(fields: [countryId], references: [id])
  city    City?   @relation(fields: [cityId], references: [id])

  @@index([status, createdAt])
  @@map("partner_applications")
}

enum PartnerApplicationStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
}

// ---------- Equipment marketplace ----------
//
// A separate business line from booking: manufacturers/distributors of medical equipment
// list products, and doctors order from whichever supplier they choose. Suppliers are
// tenant-less like Representative and Patient — a manufacturer sells across every clinic on
// the platform, not into one — so none of these models carry tenantId or go through
// runWithTenant; ownership is an explicit supplierId/doctorId check in
// src/lib/services/equipment.ts, the same shape as clinical-access.ts.

model Supplier {
  id        String    @id @default(uuid())
  userId    String    @unique
  name      String
  nameAr    String
  countryId String
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User               @relation(fields: [userId], references: [id])
  country  Country            @relation(fields: [countryId], references: [id])
  products EquipmentProduct[]
  orders   EquipmentOrder[]

  @@index([countryId])
  @@map("suppliers")
}

enum EquipmentProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model EquipmentProduct {
  id            String                  @id @default(uuid())
  supplierId    String
  name          String
  nameAr        String
  description   String?
  descriptionAr String?
  /// Free text, same convention as Doctor.subSpecialty — equipment categories are too broad
  /// and vendor-specific for a fixed enum to stay honest.
  category      String
  priceMinor    Int
  currency      String                  @default("JOD")
  stockQty      Int                     @default(0)
  status        EquipmentProductStatus  @default(DRAFT)
  imageUrl      String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  deletedAt     DateTime?

  supplier   Supplier             @relation(fields: [supplierId], references: [id])
  orderItems EquipmentOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("equipment_products")
}

enum EquipmentOrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model EquipmentOrder {
  id              String                @id @default(uuid())
  supplierId      String
  doctorId        String
  status          EquipmentOrderStatus  @default(PENDING)
  totalMinor      Int
  currency        String                @default("JOD")
  shippingAddress String
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  supplier Supplier             @relation(fields: [supplierId], references: [id])
  doctor   Doctor               @relation(fields: [doctorId], references: [id])
  items    EquipmentOrderItem[]

  @@index([supplierId, createdAt])
  @@index([doctorId, createdAt])
  @@map("equipment_orders")
}

model EquipmentOrderItem {
  id             String @id @default(uuid())
  orderId        String
  productId      String
  quantity       Int
  /// Snapshot of EquipmentProduct.priceMinor at order time — same reasoning as
  /// Appointment.priceMinor snapshotting Service.priceMinor: a later price change must
  /// never reprice a placed order.
  unitPriceMinor Int

  order   EquipmentOrder   @relation(fields: [orderId], references: [id])
  product EquipmentProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("equipment_order_items")
}
